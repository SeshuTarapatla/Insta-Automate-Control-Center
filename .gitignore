# --- Flutter / Dart (app/) ---
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/generated_plugin_registrant.*
**/GeneratedPluginRegistrant.*

# Flutter Windows platform build artifacts
app/windows/flutter/generated_plugin_registrant.cc
app/windows/flutter/generated_plugin_registrant.h
app/windows/flutter/generated_plugins.cmake
app/windows/flutter/ephemeral/

# Local DevTools settings, auto-generated by `flutter run`
**/devtools_options.yaml

# --- Python / uv (agent/) ---
agent/.venv/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# --- Logs ---
*.log

# --- Local secrets / runtime state (never commit) ---
.env
.env.local
*.token
.claude

# Note: pubspec.lock (app/) and uv.lock (agent/) are intentionally
# NOT ignored — both must be committed for an application (not a package).
